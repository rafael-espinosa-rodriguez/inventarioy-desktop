{
  "name": "inventarioy",
  "private": true,
  "version": "1.0.0",
  "description": "InventarioY Desktop - Gestión de inventario offline",
  "author": "InventarioY",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "electron:build": "tsc -p electron/tsconfig.json && node -e \"require('fs').cpSync('electron/build', 'electron/dist/build', { recursive: true })\" && node -e \"console.log('electron:build OK')\"",
    "electron:dev": "npm run electron:build && concurrently -k \"npm:dev\" \"npm:electron:serve\"",
    "electron:serve": "cross-env INVENTARIOY_DEV=1 electron .",
    "desktop": "npm run build && npm run electron:build && electron .",
    "desktop:package": "npm run build && npm run electron:build && electron-builder"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "fastify": "^5.11.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-qr-code": "^2.0.21",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "zustand": "^5.0.11"
  },
  "build": {
    "appId": "com.inventarioy.desktop",
    "productName": "InventarioY",
    "files": [
      "dist/**",
      "electron/dist/**",
      "electron/build/**",
      "electron/package.json"
    ],
    "directories": {
      "buildResources": "electron/build",
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
